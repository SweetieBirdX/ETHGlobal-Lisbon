# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Hedera testnet accounts (two separate accounts: portal.hedera.com/dashboard) ---
SELLER_ACCOUNT_ID=
SELLER_PRIVATE_KEY=
BUYER_ACCOUNT_ID=
BUYER_PRIVATE_KEY=

# --- LLM (natural-language policy parsing) ---
OPENAI_API_KEY=

# --- x402 payment layer (facilitator: blocky402, asset: native HBAR) ---
X402_FACILITATOR_URL=
X402_PAY_TO_ACCOUNT=

# --- HCS audit trail (generated by the script in Phase 1.3) ---
HCS_AUDIT_TOPIC_ID=

# --- ERC-8004 registries (already deployed on Hedera Testnet — do not change) ---
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
